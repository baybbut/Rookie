{
  // Cơ sở dữ liệu SQL Server dùng chung cho website, trang /admin và app WinForms (qua Web API).
  // Máy khác: đổi Server (ví dụ "localhost\\SQLEXPRESS" hoặc "(localdb)\\MSSQLLocalDB"); dùng tài khoản SQL thì thay
  // Trusted_Connection=True bằng "User Id=sa;Password=...". Database chưa có sẽ tự được tạo kèm dữ liệu mẫu khi chạy lần đầu.
  "ConnectionStrings": {
    "Shop": "Server=.;Database=RookieDB;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore": "Warning" }
  }
}

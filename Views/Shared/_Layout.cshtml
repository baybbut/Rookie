@inject Rookie.Services.CartService Cart
<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="theme-color" content="#f7eee5"/><meta name="description" content="Rookie — tiệm bánh nhỏ, niềm vui to. Bánh tươi làm thủ công mỗi ngày."/><title>Rookie — A little sweet, a lot of joy</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head><body>
<div class="announcement">Một chút ngọt ngào cho ngày của bạn <span>✳</span> <b>Bánh ngon, làm bằng cả tấm lòng</b></div>
<header><a href="/" class="logo" aria-label="Rookie trang chủ">rookie<span>✳</span><small>THE HAPPY LITTLE BAKERY</small></a><nav aria-label="Điều hướng chính"><a href="/#cakes">Tiệm bánh</a><a href="/#story">Chuyện Rookie</a><a href="#footer">Ghé thăm tụi mình ↗</a></nav><div class="tools"><button id="searchToggle" aria-label="Tìm bánh">⌕</button><a href="/Shop/Cart">Giỏ bánh <span id="cartCount">@((await Cart.Lines()).Sum(l=>l.Quantity))</span></a><a href="/Account/Profile">@(User.Identity?.IsAuthenticated==true?"Tài khoản":"Đăng nhập")</a></div></header>
@RenderBody()
<footer id="footer"><div><a href="/" class="logo">rookie✳</a><p>Một chiếc bánh nhỏ. Một ngày thật vui.</p></div><div><b>Ghé chơi với Rookie</b><p>Tiệm bánh trực tuyến · Việt Nam</p><p>Mở cửa mỗi ngày, 8:00 – 20:00</p></div><div><b>Giữ liên lạc nhé!</b><p>hello@rookie.bakery</p><a href="/#cakes">Chọn một chút ngọt ngào ↗</a></div><small>© @DateTime.Now.Year Rookie Bakery. Made with butter & love.</small></footer>
<div id="csrf" hidden>@Html.AntiForgeryToken()</div><div id="toast" role="status"></div><script src="~/js/site.js" asp-append-version="true"></script></body></html>
@{
 var authed = User.Identity?.IsAuthenticated == true;
 var nav = ViewData["Nav"] as string;
 string Cls(string key) => nav == key ? "active" : "";
 var meName = User.Identity?.Name ?? "";
 var meRole = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
 var meUser = User.FindFirst("username")?.Value ?? "";
 var isAdmin = User.IsInRole(Rookie.Models.StaffRole.Admin);
}
<!DOCTYPE html>
<html lang="vi"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex"/><title>@(ViewData["Title"] ?? "Quản trị") — Rookie Admin</title><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/><link rel="stylesheet" href="~/css/admin.css" asp-append-version="true"/></head><body class="admin @(authed ? "with-side" : "") @(ViewBag.Print == true ? "print-mode" : "")">
@if (authed) {
<aside class="sidebar">
 <a href="/admin" class="logo" aria-label="Rookie admin">rookie<span>✳</span><small>ADMIN · QUẢN TRỊ TIỆM BÁNH</small></a>
 <nav aria-label="Chức năng quản trị">
  <a class="@Cls("dashboard")" href="/admin" title="Trang chủ"><span>Trang chủ</span></a>
  <a class="@Cls("categories")" href="/admin/categories" title="Quản lý danh mục"><span>Quản lý danh mục</span></a>
  <a class="@Cls("products")" href="/admin/products" title="Quản lý sản phẩm"><span>Quản lý sản phẩm</span></a>
  <a class="@Cls("customers")" href="/admin/customers" title="Quản lý khách hàng"><span>Quản lý khách hàng</span></a>
  <a class="@Cls("orders")" href="/admin/orders" title="Quản lý đơn hàng"><span>Quản lý đơn hàng</span></a>
  <a class="@Cls("warehouse")" href="/admin/purchases" title="Quản lý kho"><span>Quản lý kho</span></a>
  @if (isAdmin) {<a class="@Cls("staff")" href="/admin/staff" title="Quản lý nhân sự"><span>Quản lý nhân sự</span></a>}
  <a class="@Cls("reports")" href="/admin/reports" title="Báo cáo và thống kê"><span>Báo cáo &amp; thống kê</span></a>
 </nav>
 <div class="side-foot">
  <div class="who" title="@meName · @meRole"><b class="av">@(meName.Trim().Length > 0 ? meName.Trim().Split(' ')[^1][..1].ToUpper() : "?")</b><div><strong>@meName</strong><em>@meRole@(meUser.Length > 0 ? " · @" + meUser : "")</em></div></div>
  <form method="post" asp-controller="Admin" asp-action="Logout"><button class="ghost" title="Đăng xuất">Đăng xuất</button></form>
 </div>
</aside>
}
<main class="admin-main">@RenderBody()</main>
<script>document.addEventListener('submit',e=>{const m=e.target.dataset&&e.target.dataset.confirm;if(m&&!confirm(m))e.preventDefault()});</script>
</body></html>


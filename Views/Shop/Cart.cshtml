@model List<Rookie.Models.CartLine>
<section class="section commerce-page"><div class="eyebrow">A BOX FULL OF HAPPINESS</div><h1>Giỏ bánh của bạn.</h1>
@if(Model.Count==0){<div class="empty-card"><h2>Chưa có chiếc bánh nào ở đây.</h2><p>Thêm chút ngọt ngào cho ngày của bạn nhé.</p><a class="btn" href="/#cakes">Khám phá tiệm bánh ↗</a></div>}else{<div class="checkout-grid"><div class="form-card">@foreach(var line in Model){<div class="basket-row"><img src="https://images.unsplash.com/@(line.Product.Image)?auto=format&fit=crop&w=180&q=70" alt="@line.Product.Name"/><div><a asp-action="Details" asp-route-id="@line.Product.Id"><h3>@line.Product.Name</h3></a><p>@line.Product.Price.ToString("N0") ₫ / chiếc</p><form asp-action="Update" method="post" class="quantity-form"><input type="hidden" name="id" value="@line.Product.Id"/><label>Số lượng<input type="number" name="quantity" min="0" max="99" value="@line.Quantity" required/></label><button class="text-link">Cập nhật</button></form><form asp-action="Update" method="post"><input type="hidden" name="id" value="@line.Product.Id"/><input type="hidden" name="quantity" value="0"/><button class="remove">Xóa khỏi giỏ</button></form></div><b>@((line.Product.Price*line.Quantity).ToString("N0")) ₫</b></div>}</div><aside class="form-card summary"><h2>Hộp bánh của bạn</h2><div class="total">Tạm tính <b>@Model.Sum(l=>l.Product.Price*l.Quantity).ToString("N0") ₫</b></div><p>Giao hàng: miễn phí</p><a class="btn" asp-controller="Orders" asp-action="Checkout">Tiến hành đặt hàng ↗</a><a href="/#cakes">Tiếp tục chọn bánh</a></aside></div>}</section>
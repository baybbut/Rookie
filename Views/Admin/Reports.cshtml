@model ReportVm
@{
 ViewData["Title"] = "Báo cáo và thống kê"; ViewData["Nav"] = "reports";
 decimal Max(List<NamedValue> l) => Math.Max(1, l.Select(x => x.Value).DefaultIfEmpty(1).Max());
}
<div class="admin-head"><div><div class="eyebrow">REPORTS</div><h1>Báo cáo &amp; thống kê</h1></div>
 <div class="tabs filters">@foreach (var d in new[] { 7, 30, 90 }) {<a class="@(Model.Days == d ? "active" : "")" href="/admin/reports?days=@d">@d ngày</a>}</div></div>
<div class="stats">
 <div class="stat"><small>Doanh thu</small><b>@Fmt.Vnd(Model.Revenue)</b></div>
 <div class="stat"><small>Chi nhập hàng</small><b>@Fmt.Vnd(Model.Cost)</b></div>
 <div class="stat"><small>Lãi tạm tính (thu − nhập)</small><b>@Fmt.Vnd(Model.Profit)</b></div>
 <div class="stat"><small>Số đơn (không tính đã hủy)</small><b>@Model.OrderCount</b></div>
 <div class="stat"><small>Giá trị TB / đơn</small><b>@Fmt.Vnd(Model.AvgOrder)</b></div>
</div>
<section class="panel wide"><h2>Doanh thu theo ngày</h2><partial name="_RevenueChart" model="Model.Series"/></section>
<div class="panels">
 <section class="panel"><h2>Bánh bán chạy (theo doanh thu)</h2>
  @{ var mp = Max(Model.TopProducts); }
  @foreach (var t in Model.TopProducts) {<div class="bar-row"><span>@t.Name</span><div class="bar"><i style="width:@((int)(t.Value * 100 / mp))%"></i></div><b>@t.Count</b></div>}
  @if (Model.TopProducts.Count == 0) {<p class="hint">Chưa có dữ liệu.</p>}
 </section>
 <section class="panel"><h2>Khách hàng chi nhiều nhất</h2>
  @{ var mc = Max(Model.TopCustomers); }
  @foreach (var t in Model.TopCustomers) {<div class="bar-row"><span>@t.Name</span><div class="bar"><i style="width:@((int)(t.Value * 100 / mc))%"></i></div><b>@t.Count</b></div>}
  @if (Model.TopCustomers.Count == 0) {<p class="hint">Chưa có dữ liệu.</p>}
 </section>
 <section class="panel"><h2>Đơn theo trạng thái</h2>
  <table class="mini"><tbody>@foreach (var s in Model.ByStatus) {<tr><td><span class="st @Fmt.StatusClass(s.Name)">@s.Name</span></td><td class="num">@s.Count đơn</td><td class="num">@Fmt.Vnd(s.Value)</td></tr>}</tbody></table>
 </section>
 <section class="panel"><h2>Nhập hàng theo nhà cung cấp</h2>
  <table class="mini"><tbody>@foreach (var s in Model.BySupplier) {<tr><td>@s.Name</td><td class="num">@s.Count phiếu</td><td class="num">@Fmt.Vnd(s.Value)</td></tr>}</tbody></table>
  @if (Model.BySupplier.Count == 0) {<p class="hint">Chưa có phiếu nhập.</p>}
 </section>
</div>

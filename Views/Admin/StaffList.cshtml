@model List<Staff>
@{ ViewData["Title"] = "Quản lý nhân sự"; ViewData["Nav"] = "staff"; int me = ViewBag.Me; var anyFilter = new[] { ViewBag.Q, ViewBag.Role, ViewBag.Status }.Any(x => !string.IsNullOrEmpty((string?)x)); }
<div class="admin-head"><div><div class="eyebrow">STAFF</div><h1>Quản lý nhân sự</h1></div><a class="btn" asp-action="CreateStaff">Thêm nhân sự <span>+</span></a></div>
@if (TempData["Msg"] is string msg) {<p class="notice" role="status">@msg</p>}
<form class="filter-bar" method="get" aria-label="Lọc nhân sự">
 <label class="grow">Tìm nhân sự<input name="q" value="@ViewBag.Q" placeholder="Họ tên, tên đăng nhập hoặc số điện thoại…"/></label>
 <label>Vai trò<select name="role"><option value="">Tất cả</option>@foreach (var r in StaffRole.All) {<option value="@r" selected="@((string?)ViewBag.Role == r)">@r</option>}</select></label>
 <label>Trạng thái<select name="status"><option value="">Tất cả</option><option value="active" selected="@((string?)ViewBag.Status == "active")">Hoạt động</option><option value="locked" selected="@((string?)ViewBag.Status == "locked")">Đã khóa</option></select></label>
 <div class="filter-actions"><button class="ghost on">Lọc</button>@if (anyFilter) {<a class="ghost" href="/admin/staff">Xóa lọc</a>}</div>
</form>
<div class="table-wrap"><table>
 <thead><tr><th>Nhân sự</th><th>Tên đăng nhập</th><th>Vai trò</th><th>Liên hệ</th><th>Trạng thái</th><th></th></tr></thead>
 <tbody>
 @foreach (var s in Model) {
  <tr>
   <td><b>@s.FullName</b>@if (s.Id == me) {<span class="tag mint">Bạn</span>}<small>Tham gia @Fmt.Day(s.CreatedAt)</small></td>
   <td>@s.Username</td><td><span class="tag @(s.Role == StaffRole.Admin ? "" : "plain")">@s.Role</span></td><td>@(s.Phone ?? "—")</td>
   <td><span class="st @(s.IsLocked ? "st-cancel" : "st-done")">@(s.IsLocked ? "Đã khóa" : "Hoạt động")</span></td>
   <td class="actions"><a class="ghost" asp-action="EditStaff" asp-route-id="@s.Id">Sửa</a>
    @if (s.Id != me || s.IsLocked) {<form method="post" asp-action="ToggleStaffLock" asp-route-id="@s.Id" data-confirm="@(s.IsLocked ? $"Mở khóa tài khoản “{s.FullName}”?" : $"Khóa tài khoản “{s.FullName}”? Người này sẽ bị đăng xuất và không đăng nhập được nữa.")"><button class="ghost @(s.IsLocked ? "" : "danger")">@(s.IsLocked ? "Mở khóa" : "Khóa")</button></form>}</td>
  </tr>
 }
 @if (Model.Count == 0) {<tr><td colspan="6" class="empty">Không có nhân sự nào.</td></tr>}
 </tbody>
</table></div>

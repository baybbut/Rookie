@model Product
@{ var isNew = Model.Id == 0; ViewData["Title"] = isNew ? "Thêm bánh" : "Sửa bánh"; ViewData["Nav"] = "products"; var curStatus = ProductStatus.Key(Model); }
<div class="admin-head"><div><div class="eyebrow">@(isNew ? "NEW PRODUCT" : "EDIT PRODUCT")</div><h1>@(isNew ? "Thêm bánh mới" : Model.Name)</h1></div><a class="ghost" asp-action="Products">← Quay lại</a></div>
<form class="admin-form" method="post" asp-action="@(isNew ? "Create" : "Edit")" asp-route-id="@(isNew ? null : Model.Id)" enctype="multipart/form-data">
 <div asp-validation-summary="ModelOnly" class="alert"></div>
 <div class="row">
  <label>Mã bánh<input asp-for="Code" maxlength="20" placeholder="Để trống để tự tạo (VD: SP007)"/><span asp-validation-for="Code" class="field-error"></span></label>
  <label>Tên bánh<input asp-for="Name" maxlength="80"/><span asp-validation-for="Name" class="field-error"></span></label>
 </div>
 <label>Mô tả ngắn<input asp-for="Description" maxlength="200"/><span asp-validation-for="Description" class="field-error"></span></label>
 <div class="row">
  <label>Danh mục<select asp-for="Category"><option value="">— Chọn danh mục —</option>@foreach (var c in (List<string>)ViewBag.Categories) {<option value="@c" selected="@(c == Model.Category)">@c</option>}</select><span asp-validation-for="Category" class="field-error"></span></label>
  <label>Trạng thái<select name="status">@foreach (var (k, l) in ProductStatus.Options) {<option value="@k" selected="@(k == curStatus)">@l</option>}</select><small>“Bán chạy nhất” và “Mới ra lò” hiện thành nhãn trên trang bán bánh.</small></label>
 </div>
 <div class="row">
  @{ var sups = (List<Supplier>)ViewBag.Suppliers; }
  @if (isNew) {<label>Bánh của xưởng (giá nhập cố định)<select name="priceId" required><option value="">— Chọn bánh trong danh sách của xưởng —</option>@foreach (var c in (List<SupplierPriceRow>)ViewBag.Catalog) {<option value="@c.Id" selected="@(c.Id == (int?)ViewBag.PriceId)">@c.Supplier — @c.Product (@c.Unit) — @c.Price.ToString("N0") ₫</option>}</select><small>Giá nhập lấy theo giá xưởng, không sửa được. Thêm bánh vào danh sách của xưởng trong app quản trị.</small><span asp-validation-for="SupplierId" class="field-error"></span></label>}
  else {<label>Giá nhập (cố định)<input value="@Model.CostPrice.ToString("N0") ₫ · @(sups.FirstOrDefault(s => s.Id == Model.SupplierId)?.Name ?? "chưa có xưởng chính")" disabled/><small>Đổi trong bảng giá xưởng (app quản trị).</small></label>}
  <label>Tỉ lệ lợi nhuận (%)<input asp-for="Margin" type="number" step="1" min="0" max="1000"/><small>Giá bán = giá nhập × (1 + tỉ lệ), làm tròn 1.000 ₫.@(Model.Price > 0 ? $" Giá bán hiện tại: {Model.Price:N0} ₫." : "")</small><span asp-validation-for="Margin" class="field-error"></span></label>
 </div>
 <div class="row">
  <label>Đơn vị bán<select asp-for="Unit">@foreach (var u in ProductStatus.Units) {<option value="@u" selected="@(u == Model.Unit)">@u</option>}</select><small>Đơn vị tính của một phần bánh (dùng cho giá, phiếu nhập và tồn kho).</small><span asp-validation-for="Unit" class="field-error"></span></label>
 </div>
 <div class="row">
  <label>Tải ảnh từ máy<input type="file" name="upload" accept=".jpg,.jpeg,.png,.webp,.gif"/><small>JPG, PNG, WEBP hoặc GIF, tối đa 5 MB. Chọn ảnh mới sẽ thay ảnh hiện tại.</small></label>
  <label>Hoặc mã ảnh Unsplash<input asp-for="Image" maxlength="120" placeholder="photo-1464305795204-6f5bbfc7fb81"/><small>Phần ID sau images.unsplash.com/. Ảnh đã tải lên hiện dạng /uploads/...</small><span asp-validation-for="Image" class="field-error"></span></label>
 </div>
 @if (!string.IsNullOrWhiteSpace(Model.Image)) {<img class="preview" src="@Product.Url(Model.Image, 500)" alt="Xem trước ảnh"/>}
 <div class="form-actions"><button class="btn" type="submit">@(isNew ? "Thêm bánh" : "Lưu thay đổi") <span>↗</span></button></div>
</form>

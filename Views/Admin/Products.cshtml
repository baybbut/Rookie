@model List<Product>
@{ ViewData["Title"] = "Sản phẩm"; ViewData["Nav"] = "products"; var vn = System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); }
<div class="admin-head"><div><div class="eyebrow">PRODUCTS</div><h1>Sản phẩm</h1></div><div class="head-actions"><a class="ghost" asp-action="Categories">← Danh mục</a><a class="btn" asp-action="Create">Thêm bánh mới <span>+</span></a></div></div>
@if (TempData["Msg"] is string msg) {<p class="notice" role="status">@msg</p>}
<form class="admin-search" method="get"><input name="q" value="@ViewBag.Q" placeholder="Tìm theo tên hoặc danh mục…" aria-label="Tìm sản phẩm"/><button class="ghost">Tìm</button>@if (!string.IsNullOrEmpty((string?)ViewBag.Q)) {<a class="ghost" href="/admin/products">Xóa lọc</a>}</form>
<div class="table-wrap"><table>
 <thead><tr><th></th><th>Tên bánh</th><th>Danh mục</th><th class="num">Giá</th><th>Nhãn</th><th></th></tr></thead>
 <tbody>
 @foreach (var p in Model) {
  <tr>
   <td><img class="thumb" src="https://images.unsplash.com/@(p.Image)?auto=format&fit=crop&w=120&q=70" alt="" loading="lazy"/></td>
   <td><b>@p.Name</b><small>@p.Description</small></td>
   <td>@p.Category</td>
   <td class="num">@p.Price.ToString("N0", vn) ₫</td>
   <td>@if (p.IsBestSeller) {<span class="tag">Bán chạy</span>}@if (p.IsNew) {<span class="tag mint">Mới</span>}</td>
   <td class="actions"><a class="ghost" asp-action="Edit" asp-route-id="@p.Id">Sửa</a>
    <form method="post" asp-action="Delete" asp-route-id="@p.Id" onsubmit="return confirm('Xóa “@p.Name.Replace("'", "\\'")”? Không hoàn tác được.')"><button class="ghost danger">Xóa</button></form></td>
  </tr>
 }
 @if (Model.Count == 0) {<tr><td colspan="6" class="empty">Không có sản phẩm nào.</td></tr>}
 </tbody>
</table></div>

@model List<Product>
@{ ViewData["Title"] = "Quản lý sản phẩm"; ViewData["Nav"] = "products"; var vn = System.Globalization.CultureInfo.GetCultureInfo("vi-VN"); var cats = (List<string>)ViewBag.Categories; var anyFilter = new[] { ViewBag.Code, ViewBag.Name, ViewBag.Category, ViewBag.Status }.Any(x => !string.IsNullOrEmpty((string?)x)); }
<div class="admin-head"><div><div class="eyebrow">PRODUCTS</div><h1>Quản lý sản phẩm</h1></div><div class="head-actions"><a class="btn" asp-action="Create">Thêm bánh mới <span>+</span></a></div></div>
@if (TempData["Msg"] is string msg) {<p class="notice" role="status">@msg</p>}
<form class="filter-bar" method="get" aria-label="Lọc sản phẩm">
 <label>Mã bánh<input name="code" value="@ViewBag.Code" placeholder="VD: SP001"/></label>
 <label>Tên bánh<input name="name" value="@ViewBag.Name" placeholder="VD: tiramisu"/></label>
 <label>Danh mục<select name="category"><option value="">Tất cả</option>@foreach (var c in cats) {<option value="@c" selected="@(c == (string?)ViewBag.Category)">@c</option>}</select></label>
 <label>Trạng thái<select name="status"><option value="">Tất cả</option>@foreach (var (k, l) in ProductStatus.Options) {<option value="@(k == "" ? "normal" : k)" selected="@((k == "" ? "normal" : k) == (string?)ViewBag.Status)">@l</option>}</select></label>
 <div class="filter-actions"><button class="ghost on">Lọc</button>@if (anyFilter) {<a class="ghost" href="/admin/products">Xóa lọc</a>}</div>
</form>
<div class="table-wrap"><table>
 <thead><tr><th></th><th>Mã</th><th>Tên bánh</th><th>Danh mục</th><th class="num">Giá</th><th>Trạng thái</th><th></th></tr></thead>
 <tbody>
 @foreach (var p in Model) {
  <tr>
   <td><img class="thumb" src="https://images.unsplash.com/@(p.Image)?auto=format&fit=crop&w=120&q=70" alt="" loading="lazy"/></td>
   <td><b>@p.Code</b></td>
   <td><b>@p.Name</b><small>@p.Description</small></td>
   <td>@p.Category</td>
   <td class="num">@p.Price.ToString("N0", vn) ₫<small>/ @p.Unit</small></td>
   <td>@if (p.IsBestSeller) {<span class="tag">Bán chạy</span>}@if (p.IsNew) {<span class="tag mint">Mới</span>}@if (!p.IsBestSeller && !p.IsNew) {<span class="tag plain">Bình thường</span>}</td>
   <td class="actions"><a class="ghost" asp-action="Edit" asp-route-id="@p.Id">Sửa</a>
    <form method="post" asp-action="Delete" asp-route-id="@p.Id" data-confirm="Xóa “@p.Name”? Không hoàn tác được."><button class="ghost danger">Xóa</button></form></td>
  </tr>
 }
 @if (Model.Count == 0) {<tr><td colspan="7" class="empty">Không có sản phẩm nào.</td></tr>}
 </tbody>
</table></div>

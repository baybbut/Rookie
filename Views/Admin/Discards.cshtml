@model List<Discard>
@{ ViewData["Title"] = "Bánh hủy"; ViewData["Nav"] = "warehouse"; var df = (DateFilter)ViewBag.Date; var stock = (List<StockRow>)ViewBag.Stock; var anyFilter = !string.IsNullOrEmpty((string?)ViewBag.Q) || df.Day is not null || df.Month is not null || df.Year is not null; }
<div class="admin-head"><div><div class="eyebrow">DISCARDS</div><h1>Bánh hủy</h1></div></div>
<partial name="_WarehouseTabs" model='"discards"'/>
@if (TempData["Msg"] is string msg) {<p class="notice" role="status">@msg</p>}
@if (TempData["Err"] is string er) {<p class="alert" role="alert">@er</p>}
<section class="panel wide"><h2>Ghi nhận bánh hủy</h2>
 <form class="filter-bar flat" method="post" asp-action="CreateDiscard" data-confirm="Ghi nhận hủy bánh? Số bánh này sẽ bị trừ khỏi tồn kho.">
  <label class="grow">Bánh<select name="productId" required><option value="">— Chọn bánh —</option>@foreach (var s in stock) {<option value="@s.Product.Id" disabled="@(s.Left <= 0)">@s.Product.Code · @s.Product.Name (tồn @s.Left @s.Product.Unit)</option>}</select></label>
  <label>Số lượng<input type="number" name="quantity" min="1" step="1" value="1" required/></label>
  <label>Lý do<select name="reason" required>@foreach (var r in DiscardReasons.All) {<option>@r</option>}</select></label>
  <label>Ngày hủy<input type="date" name="date" value="@DateTime.Today.ToString("yyyy-MM-dd")" max="@DateTime.Today.ToString("yyyy-MM-dd")" required/></label>
  <label class="grow">Ghi chú<input name="note" maxlength="100" placeholder="Tùy chọn"/></label>
  <div class="filter-actions"><button class="btn" type="submit">Ghi nhận <span>+</span></button></div>
 </form>
</section>
<form class="filter-bar" method="get" aria-label="Tìm bánh hủy">
 <label class="grow">Tìm<input name="q" value="@ViewBag.Q" placeholder="Tên bánh hoặc lý do…"/></label>
 <partial name="_DateFilter" model="df"/>
 <div class="filter-actions"><button class="ghost on">Lọc</button>@if (anyFilter) {<a class="ghost" href="/admin/discards">Xóa lọc</a>}</div>
</form>
<div class="table-wrap"><table>
 <thead><tr><th>Ngày hủy</th><th>Bánh</th><th class="num">Số lượng</th><th>Lý do</th><th class="num">Giá trị</th><th>Người ghi</th></tr></thead>
 <tbody>
 @foreach (var d in Model) {<tr><td>@Fmt.Day(d.CreatedAt)</td><td>@d.ProductName</td><td class="num">@d.Quantity @d.Unit</td><td>@d.Reason</td><td class="num">@Fmt.Vnd(d.Value)</td><td>@d.CreatedBy</td></tr>}
 @if (Model.Count == 0) {<tr><td colspan="6" class="empty">Không có bánh hủy nào.</td></tr>}
 @if (Model.Count > 0) {<tr class="sum"><td colspan="2" class="num"><b>Tổng</b></td><td class="num"><b>@Model.Sum(d => d.Quantity)</b></td><td></td><td class="num"><b>@Fmt.Vnd(Model.Sum(d => d.Value))</b></td><td></td></tr>}
 </tbody>
</table></div>

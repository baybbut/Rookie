@model List<Order>
@{
 ViewData["Title"] = "Quản lý đơn hàng"; ViewData["Nav"] = "orders";
 var counts = (Dictionary<string, int>)ViewBag.Counts; var cur = (string?)ViewBag.Status; var q = (string?)ViewBag.Q; var dFrom = (string?)ViewBag.From; var dTo = (string?)ViewBag.To; int? cid = ViewBag.CustomerId;
 // Giữ nguyên các bộ lọc khác khi đổi tab trạng thái.
 string TabUrl(string? st, bool keepCustomer = true) { var parts = new List<string>(); if (!string.IsNullOrEmpty(st)) parts.Add("status=" + Uri.EscapeDataString(st)); if (!string.IsNullOrEmpty(q)) parts.Add("q=" + Uri.EscapeDataString(q)); if (keepCustomer && cid is int c) parts.Add("customer=" + c); if (!string.IsNullOrEmpty(dFrom)) parts.Add("from=" + dFrom); if (!string.IsNullOrEmpty(dTo)) parts.Add("to=" + dTo); return "/admin/orders" + (parts.Count > 0 ? "?" + string.Join("&", parts) : ""); }
 var anyFilter = !string.IsNullOrEmpty(q) || !string.IsNullOrEmpty(dFrom) || !string.IsNullOrEmpty(dTo) || cid is not null || !string.IsNullOrEmpty(cur);
 var back = Context.Request.Path + Context.Request.QueryString;
}
<div class="admin-head"><div><div class="eyebrow">ORDERS</div><h1>Quản lý đơn hàng</h1></div></div>
@if (TempData["Msg"] is string msg) {<p class="notice" role="status">@msg</p>}
<form class="filter-bar" method="get" aria-label="Tìm và lọc đơn hàng">
 <label class="grow">Tìm đơn hàng<input name="q" value="@q" placeholder="Mã đơn, tên hoặc số điện thoại khách…"/></label>
 <label>Từ ngày<input type="date" name="from" value="@dFrom"/></label>
 <label>Đến ngày<input type="date" name="to" value="@dTo"/></label>
 <label>Trạng thái<select name="status"><option value="">Tất cả</option>@foreach (var s in OrderStatus.All) {<option value="@s" selected="@(cur == s)">@s</option>}</select></label>
 @if (cid is int c1) {<input type="hidden" name="customer" value="@c1"/>}
 <div class="filter-actions"><button class="ghost on">Lọc</button>@if (anyFilter) {<a class="ghost" href="/admin/orders">Xóa lọc</a>}</div>
</form>
@if (cid is not null) {<p class="chip-line">Đang lọc theo khách hàng: <b class="chip">@ViewBag.CustomerName <a href="@TabUrl(cur, false)" title="Bỏ lọc khách hàng" aria-label="Bỏ lọc khách hàng">✕</a></b></p>}
<div class="tabs filters" role="group" aria-label="Lọc theo trạng thái">
 <a class="@(string.IsNullOrEmpty(cur) ? "active" : "")" href="@TabUrl(null)">Tất cả (@ViewBag.Total)</a>
 @foreach (var s in OrderStatus.All) {<a class="@(cur == s ? "active" : "")" href="@TabUrl(s)">@s (@counts[s])</a>}
</div>
<div class="table-wrap"><table>
 <thead><tr><th>Mã</th><th>Khách hàng</th><th>Thời gian</th><th>Sản phẩm</th><th class="num">Tổng</th><th>Trạng thái</th><th></th></tr></thead>
 <tbody>
 @foreach (var o in Model) {
  <tr>
   <td><a class="text-link" asp-action="OrderDetail" asp-route-id="@o.Id">#@o.Id</a></td>
   <td>@o.Customer?.FullName<small>@o.Customer?.Phone</small></td><td>@Fmt.Date(o.CreatedAt)</td>
   <td>@o.Items.Sum(i => i.Quantity) món<small>@string.Join(", ", o.Items.Select(i => i.ProductName))</small></td>
   <td class="num">@Fmt.Vnd(o.Total)</td>
   <td><span class="st @Fmt.StatusClass(o.Status)">@o.Status</span>@if (o.ConfirmedBy is not null) {<small>Xác nhận: @o.ConfirmedBy</small>}</td>
   <td class="actions">
    @if (o.Status == OrderStatus.New) {<form method="post" asp-action="SetOrderStatus" asp-route-id="@o.Id" data-confirm="Xác nhận đơn #@o.Id của @(o.Customer?.FullName)?"><input type="hidden" name="status" value="@OrderStatus.Confirmed"/><input type="hidden" name="back" value="@back"/><button class="ghost on">Xác nhận</button></form>}
    <a class="ghost" asp-action="OrderDetail" asp-route-id="@o.Id">Chi tiết</a></td>
  </tr>
 }
 @if (Model.Count == 0) {<tr><td colspan="7" class="empty">Không có đơn hàng nào.</td></tr>}
 </tbody>
</table></div>



@model List<Order>
@{ ViewData["Title"] = "Quản lý đơn hàng"; ViewData["Nav"] = "orders"; var counts = (Dictionary<string, int>)ViewBag.Counts; var cur = (string?)ViewBag.Status; }
<div class="admin-head"><div><div class="eyebrow">ORDERS</div><h1>Đơn hàng</h1></div><a class="btn" asp-action="CreateOrder">Tạo đơn mới <span>+</span></a></div>
@if (TempData["Msg"] is string msg) {<p class="notice" role="status">@msg</p>}
<div class="tabs filters" role="group" aria-label="Lọc theo trạng thái">
 <a class="@(string.IsNullOrEmpty(cur) ? "active" : "")" href="/admin/orders">Tất cả (@ViewBag.Total)</a>
 @foreach (var s in OrderStatus.All) {<a class="@(cur == s ? "active" : "")" href="/admin/orders?status=@Uri.EscapeDataString(s)">@s (@counts[s])</a>}
</div>
@if (ViewBag.CustomerId is int cid) {<p class="hint">Đang lọc theo khách #@cid. <a class="text-link" href="/admin/orders">Bỏ lọc</a></p>}
<div class="table-wrap"><table>
 <thead><tr><th>Mã</th><th>Khách hàng</th><th>Thời gian</th><th>Sản phẩm</th><th class="num">Tổng</th><th>Trạng thái</th></tr></thead>
 <tbody>
 @foreach (var o in Model) {
  <tr>
   <td><a class="text-link" asp-action="OrderDetail" asp-route-id="@o.Id">#@o.Id</a></td>
   <td>@o.Customer?.FullName</td><td>@Fmt.Date(o.CreatedAt)</td>
   <td>@o.Items.Sum(i => i.Quantity) món<small>@string.Join(", ", o.Items.Select(i => i.ProductName))</small></td>
   <td class="num">@Fmt.Vnd(o.Total)</td><td><span class="st @Fmt.StatusClass(o.Status)">@o.Status</span></td>
  </tr>
 }
 @if (Model.Count == 0) {<tr><td colspan="6" class="empty">Không có đơn hàng nào.</td></tr>}
 </tbody>
</table></div>

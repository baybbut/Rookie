@model Rookie.Models.LoginInput
<section class="section account-page"><div class="eyebrow">WELCOME BACK, SWEETIE</div><h1>Rookie nhớ bạn!</h1><div class="page-links"><a asp-action="Register">Đăng ký</a><strong>Đăng nhập</strong></div><form method="post" class="form-card"><div asp-validation-summary="All" class="validation"></div><label>Tên tài khoản hoặc email<input asp-for="Email" autocomplete="username" required/></label><label>Mật khẩu<input asp-for="Password" type="password" autocomplete="current-password" required/></label><button class="btn">Đăng nhập ↗</button><p>Lần đầu ghé tiệm? <a asp-action="Register">Đăng ký tài khoản</a></p></form></section>
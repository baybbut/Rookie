@model Rookie.Models.LoginInput
<section class="section account-page"><div class="eyebrow">WELCOME BACK, SWEETIE</div><h1>Rookie nhớ bạn!</h1><form method="post" class="form-card"><div asp-validation-summary="All" class="validation"></div><label>Email<input asp-for="Email" type="email" autocomplete="email" required/></label><label>Mật khẩu<input asp-for="Password" type="password" autocomplete="current-password" required/></label><button class="btn">Đăng nhập ↗</button><p>Lần đầu ghé tiệm? <a asp-action="Register">Đăng ký tài khoản</a></p></form></section>
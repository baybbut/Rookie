@model Rookie.Models.ProfileInput
<section class="section account-page"><div class="eyebrow">YOUR LITTLE CORNER</div><h1>Góc nhỏ của bạn.</h1><div class="page-links"><a asp-controller="Orders" asp-action="Index">Lịch sử đơn hàng ↗</a></div><p class="notice" role="status">@TempData["Message"]</p><form method="post" class="form-card"><h2>Hồ sơ & địa chỉ</h2><p><b>Tên tài khoản:</b> @ViewBag.UserName</p><p><b>Email:</b> @ViewBag.Email</p><div asp-validation-summary="All" class="validation"></div><label>Họ tên<input asp-for="Name" autocomplete="name" required maxlength="100"/></label><label>Điện thoại<input asp-for="Phone" type="tel" autocomplete="tel" maxlength="30"/></label><label>Địa chỉ giao hàng<textarea asp-for="Address" autocomplete="street-address" maxlength="500" rows="3"></textarea></label><button class="btn">Chỉnh sửa ↗</button></form><form asp-action="Logout" method="post" class="profile-logout"><button class="btn btn-logout" type="submit">Đăng xuất</button></form></section>
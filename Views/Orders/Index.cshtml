@model List<Rookie.Models.Order>
<section class="section commerce-page"><div class="eyebrow">YOUR SWEET MEMORIES</div><h1>Những hộp bánh đã đặt.</h1><a asp-controller="Account" asp-action="Profile">← Hồ sơ của bạn</a>
@if(Model.Count==0){<div class="empty-card"><h2>Bắt đầu kỷ niệm ngọt ngào đầu tiên nhé!</h2><a class="btn" href="/#cakes">Chọn bánh ↗</a></div>}else{<div class="order-list">@foreach(var o in Model){<a class="form-card order-card" asp-action="Details" asp-route-id="@o.Id"><div><b>#RK@o.Id.ToString("D6")</b><p>@o.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm") (UTC+7)</p></div><span class="status">@o.Status</span><b>@o.Total.ToString("N0") ₫</b><span>Xem chi tiết ↗</span></a>}</div>}</section>
@model Rookie.Models.CheckoutInput
@{ var lines = (List<Rookie.Models.CartLine>)ViewBag.Lines; }
<section class="section commerce-page"><div class="eyebrow">ALMOST AT YOUR DOOR</div><h1>Gửi bạn chút ngọt ngào.</h1><a asp-controller="Shop" asp-action="Cart">← Quay lại giỏ bánh</a><form method="post" class="checkout-grid"><div class="form-card"><h2>Thông tin nhận bánh</h2><div asp-validation-summary="All" class="validation"></div><input asp-for="RequestKey" type="hidden"/><label>Người nhận<input asp-for="Name" autocomplete="name" required maxlength="100"/></label><label>Số điện thoại<input asp-for="Phone" type="tel" autocomplete="tel" required maxlength="30"/></label><label>Địa chỉ nhận hàng đầy đủ (số nhà, đường, phường/xã, quận/huyện, tỉnh/thành)<textarea asp-for="Address" placeholder="Ví dụ: 12 Nguyễn Huệ, phường Sài Gòn, TP. Hồ Chí Minh" autocomplete="street-address" required maxlength="500" rows="3"></textarea></label><label>Lời nhắn cho tiệm<textarea asp-for="Note" maxlength="1000" rows="3"></textarea></label><h2>Chọn thanh toán</h2><label class="payment-option"><input asp-for="Payment" type="radio" value="COD" checked/> Thanh toán khi nhận hàng (COD)</label><p class="muted">Thanh toán trực tuyến chưa được hỗ trợ. Đơn hàng sẽ chờ tiệm xác nhận; bạn chưa cần trả tiền ngay.</p></div><aside class="form-card summary"><h2>Đơn bánh của bạn</h2>@foreach(var l in lines){<div class="total"><span>@l.Product.Name × @l.Quantity</span><b>@((l.Product.Price*l.Quantity).ToString("N0")) ₫</b></div>}<p>Phí giao hàng: 0 ₫</p><div class="total"><strong>Tổng cộng</strong><strong>@lines.Sum(l=>l.Product.Price*l.Quantity).ToString("N0") ₫</strong></div><button class="btn">Xác nhận đặt hàng ↗</button><small>Kiểm tra thông tin giao bánh trước khi xác nhận.</small></aside></form></section>
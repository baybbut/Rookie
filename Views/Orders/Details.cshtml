@model Rookie.Models.Order
<section class="section commerce-page"><div class="eyebrow">BAKED WITH LOVE, JUST FOR YOU</div><h1>Đơn bánh #RK@(Model.Id.ToString("D6"))</h1><div class="page-links"><a asp-action="Index">← Lịch sử đơn hàng</a><span class="status">@Model.Status</span></div><p class="muted">Đặt lúc @Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>@if(TempData["Msg"] is string msg){<p class="notice" role="status">@msg</p>}@if(Model.Status==Rookie.Models.OrderStatus.New){<form method="post" asp-action="Cancel" asp-route-id="@Model.Id" onsubmit="return confirm('Hủy đơn này? Không thể mở lại sau khi hủy.')"><button class="ghost danger">Hủy đơn</button></form>}<div class="checkout-grid"><div class="form-card"><h2>Trong hộp bánh</h2>@foreach(var item in Model.Items){<div class="total"><div><a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">@item.ProductName</a><p class="muted">@item.Quantity × @item.UnitPrice.ToString("N0") ₫</p></div><b>@((item.Subtotal).ToString("N0")) ₫</b></div>}<div class="total"><strong>Tổng cộng (miễn phí giao hàng)</strong><strong>@Model.Total.ToString("N0") ₫</strong></div></div><aside class="form-card"><h2>Thông tin giao bánh</h2><p>@Model.ShipName · @Model.ShipPhone</p><p>@Model.ShipAddress</p><h3>Thanh toán</h3><p>@(Model.PaymentMethod ?? "COD") · @Model.PaymentStatus</p>@if(!string.IsNullOrWhiteSpace(Model.Note)){<h3>Lời nhắn</h3><p>@Model.Note</p>}@if(Rookie.Models.OrderStatus.CustomerCanEdit(Model.Status)){<details><summary>Sửa thông tin giao bánh</summary><form method="post" asp-action="EditInfo" asp-route-id="@Model.Id"><label>Người nhận<input name="Name" value="@Model.ShipName" maxlength="100" required/></label><label>Số điện thoại<input name="Phone" value="@Model.ShipPhone" maxlength="30" required/></label><label>Địa chỉ<input name="Address" value="@Model.ShipAddress" maxlength="500" required/></label><label>Lời nhắn<textarea name="Note" maxlength="1000">@Model.Note</textarea></label><button class="btn">Lưu thông tin</button></form></details>}</aside></div></section>
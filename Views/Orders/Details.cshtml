@model Rookie.Models.Order
<section class="section commerce-page"><div class="eyebrow">BAKED WITH LOVE, JUST FOR YOU</div><h1>Đơn bánh #RK@Model.Id.ToString("D6")</h1><div class="page-links"><a asp-action="Index">← Lịch sử đơn hàng</a><span class="status">@Model.Status</span></div><p class="muted">Đặt lúc @Model.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm") (UTC+7)</p><div class="checkout-grid"><div class="form-card"><h2>Trong hộp bánh</h2>@foreach(var item in Model.Items){<div class="total"><div><a asp-controller="Shop" asp-action="Details" asp-route-id="@item.ProductId">@item.Name</a><p class="muted">@item.Quantity × @item.Price.ToString("N0") ₫</p></div><b>@((item.Quantity*item.Price).ToString("N0")) ₫</b></div>}<div class="total"><strong>Tổng cộng (miễn phí giao hàng)</strong><strong>@Model.Total.ToString("N0") ₫</strong></div></div><aside class="form-card"><h2>Thông tin giao bánh</h2><p>@Model.Name · @Model.Phone</p><p>@Model.Address</p><h3>Thanh toán</h3><p>COD · Chưa thanh toán</p>@if(!string.IsNullOrWhiteSpace(Model.Note)){<h3>Lời nhắn</h3><p>@Model.Note</p>}</aside></div></section>
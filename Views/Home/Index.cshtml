@model List<Product>
<main><section class="hero"><div class="hero-copy"><div class="eyebrow">FRESHLY BAKED. HAPPILY MADE.</div><h1>A little sweet.<br/>A lot of <em>joy.</em><span class="spark">✳</span></h1><p>Bánh ngon đâu chỉ để ăn.<br/>Là một chút hạnh phúc, dành riêng cho bạn.</p><a class="btn" href="#cakes">Khám phá tiệm bánh <span>↗</span></a><div class="hero-foot"><span>♡</span> Nướng mỗi ngày, yêu thương mỗi chiếc.</div></div><div class="hero-art"><div class="circle"></div><img src="https://images.unsplash.com/photo-1578985545062-69928b1d9587?auto=format&fit=crop&w=1200&q=85" alt="Chiếc bánh kem chocolate trang trí trái mọng" fetchpriority="high"/><div class="sticker">baked with<br/><b>LOVE</b><br/>& a little butter</div><div class="handwriting">your daily slice of happiness ↗</div><span class="art-star">✷</span></div></section>
<div class="promise"><span>✳ BÁNH TƯƠI MỖI NGÀY</span><span>♡ NGUYÊN LIỆU THẬT</span><span>✳ LÀM THỦ CÔNG</span><span>♡ NGỌT NGÀO VỪA ĐỦ</span><span>✳ GÓI GHÉM YÊU THƯƠNG</span></div>
<section class="shop section" id="cakes"><div class="section-top"><div><div class="eyebrow">PICK YOUR LITTLE HAPPINESS</div><h2>Hôm nay, bạn thèm gì?</h2></div><p>Một chiếc cho mình.<br/>Một hộp cho người thương.</p></div><div class="shop-controls"><div class="tabs" role="group" aria-label="Lọc bánh"><button class="active" data-filter="best">Bán chạy nhất ↗</button><button data-filter="new">Bánh mới ra lò</button><button data-filter="all">Tất cả bánh</button></div><label class="search"><span>⌕</span><input id="search" type="search" placeholder="Tìm chiếc bánh bạn thích…" aria-label="Tìm kiếm bánh"/></label></div><div class="product-grid">
@foreach(var p in Model) {<article class="product" data-best="@p.IsBestSeller.ToString().ToLower()" data-new="@p.IsNew.ToString().ToLower()" data-name="@p.Name @p.Category"><div class="product-image"><span class="badge">@(p.IsNew ? "JUST BAKED" : "FAN FAVORITE")</span><a href="/Shop/Details/@p.Id"><img src="https://images.unsplash.com/@(p.Image)?auto=format&fit=crop&w=700&q=85" alt="@p.Name" loading="lazy"/></a><button class="add" data-id="@p.Id" data-name="@p.Name" data-price="@p.Price" aria-label="Thêm @p.Name vào giỏ">+</button></div><div class="product-meta"><small>@p.Category</small><span>★★★★★</span></div><div class="product-title"><h3><a href="/Shop/Details/@p.Id">@p.Name</a></h3><b>@p.Price.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("vi-VN")) ₫</b></div><p>@p.Description</p></article>}
</div><p id="empty" hidden>Chưa tìm thấy bánh phù hợp. Thử một tên khác nhé!</p><div class="shop-bottom"><span>Được làm bằng bơ thật và rất nhiều yêu thương.</span><a href="/Shop" class="text-link">Xem tất cả bánh ↗</a></div></section>
<section class="story" id="story"><div class="story-photo"><img src="https://images.unsplash.com/photo-1555507036-ab1f4038808a?auto=format&fit=crop&w=1000&q=85" alt="Bánh sừng bò vàng giòn mới nướng" loading="lazy"/><span>small batches.<br/>big happiness.</span></div><div class="story-copy"><div class="eyebrow">HELLO, WE'RE ROOKIE</div><h2>Tiệm bánh nhỏ.<br/>Thương mến <em>thật to.</em></h2><p>Tụi mình tin rằng những điều giản dị luôn mang đến niềm vui lớn nhất. Mùi bơ thơm từ lò, lớp bánh mềm vừa chín, và nụ cười khi mở hộp bánh.</p><p>Ở Rookie, mỗi chiếc bánh đều được làm thủ công, từ những nguyên liệu tử tế và một trái tim yêu bánh.</p><a class="text-link" href="#footer">Hẹn bạn một ngày thật ngọt ↗</a></div></section>
<section class="reviews section"><div class="eyebrow">SWEET WORDS FROM SWEET PEOPLE</div><h2>Ăn một miếng, thương một tiệm.</h2><div class="review-grid"><blockquote><div>★★★★★</div><p>“Bánh thơm bơ, ngọt vừa phải. Mở hộp ra là thấy cả một ngày vui vẻ. Chắc chắn sẽ quay lại!”</p><b>Minh Anh</b><small>Một người mê croissant</small></blockquote><blockquote><div>★★★★★</div><p>“Đặt bánh tặng sinh nhật bạn, ai cũng khen xinh và ngon. Rookie chăm chút từ bánh đến chiếc hộp.”</p><b>Thảo Nhi</b><small>Team bánh kem dâu</small></blockquote><blockquote><div>★★★★★</div><p>“Một chiếc cookie và ly cà phê là đủ cho buổi chiều hoàn hảo. Tiệm bánh chân ái của mình!”</p><b>Hoàng Nam</b><small>Cookie lover</small></blockquote></div></section><section class="last-call"><span>♡</span><h2>Life’s better with a little cake.</h2><a class="btn" href="#cakes">Chọn bánh cho hôm nay ↗</a></section></main>